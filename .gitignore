# ============================================================
# DiabloHFConverter — Git 忽略列表
# 只忽略「构建中间产物」与「运行产物」；源码、文档、参考数据均入库。
# ============================================================

# ---------- CMake 构建目录（mcp-server 产物） ----------
build-mcp/
build/
cmake-build-*/

# ---------- CMake 生成文件（若散落根目录） ----------
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
*.cmake

# ---------- StormLib（git submodule @ 3rdparty/StormLib）构建产物 ----------
# 3rdparty/StormLib 已是 submodule，其 build/ 由 build-stormlib.sh 生成、重新运行即可重建。
3rdparty/StormLib/build/

# ---------- 测试目录 tests/（仅测试源码入库） ----------
# 三套测试源码（*.cpp）在 tests/ 下入库；JSON 夹具已移除（测试自包含、不依赖）。
# 仅忽略测试编译出的可执行件与运行临时产物（见 tests/*.cpp 内硬编码路径）。
tests/*.exe
tests/__png_test.png
tests/_it_*
tests/gen_test/
tests/ui/

# ---------- 运行产物 out/（整目录忽略） ----------
# 测试套件源码已迁至 tests/；out/ 只承载 mcp-server 与辅助工具的运行产物，
# out_bak/ 为 out/ 的备份，两者均整目录忽略、不入库。
out/
out_bak/

# ---------- MPQ 文件名恢复的生成产出（字典源文件保留） ----------
# recovered.json / recovered/ 可由 mcp-server 的 mpq.recover 重建。
mpq-info/dict/recovered.json
mpq-info/dict/recovered/

# ---------- 编译中间文件 ----------
*.o
*.obj
*.exe
# 注：mcp-server.exe 位于 build-mcp/ 已整体忽略；
#     libStormLib.a 位于 3rdparty/StormLib/build/ 已整体忽略，
#     故此处不必再列 *.a。

# ---------- 编辑器 / IDE / OS 噪声 ----------
.vscode/
.idea/
.vs/
*.swp
*.swo
*~
Thumbs.db
Desktop.ini

# ---------- 日志 ----------
*.log

# ---------- 外来文件（来自其他项目，不应入库） ----------
# changed-history.tools996.txt 是误置入本仓库的其他项目改动日志，已另行保管；
# 本项目的改动历史记录在 changed-history.txt（入库，不忽略）。
changed-history.tools996.txt


# ---------- 原生动态地牢生成产物（level.generate / map.build dun_path） ----------
out/gen/
out/gen_test/
out/maps_dbg/
out/maps_random/

